# Backend — Environment Variables
# Copy this file to .env and fill in your values

GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Admin connection (used ONLY for running init_db.sql + seed_db.sql)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_admin_password@db.your-project.supabase.co:5432/postgres

# Read-only connection (used by the agent — created by init_db.sql)
# Replace HOST and DATABASE with your Supabase details
READONLY_DATABASE_URL=postgresql://analyst_readonly:readonly_secure_pass_123@db.your-project.supabase.co:5432/postgres

PORT=3001
FRONTEND_URL=http://localhost:5173
